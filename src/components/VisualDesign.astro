---
/* Ilustración animada de solyd.design: una pantalla se compone, se selecciona y se ajusta. */
---

<div class="stage vx" aria-hidden="true">
  <div class="vx-frame">
    <div class="vx-top"><i></i><i></i><i></i><span>solyd.design</span></div>
    <div class="vx-canvas">
      <div class="vx-nav"><b></b><i></i><i></i><i></i></div>
      <div class="vx-hero">
        <div class="vx-copy">
          <div class="vx-h vx-h1"></div>
          <div class="vx-h vx-h2"></div>
          <div class="vx-p"></div>
          <div class="vx-btn"></div>
          <div class="vx-select"><i></i><i></i><i></i><i></i></div>
        </div>
        <div class="vx-img"></div>
      </div>
      <div class="vx-cards"><i style="--i:0"></i><i style="--i:1"></i><i style="--i:2"></i></div>

      <svg class="vx-cursor" width="22" height="22" viewBox="0 0 24 24">
        <path d="M5 3l14 8-6.2 1.6L9.6 19 5 3z" fill="#fff" stroke="#01013f" stroke-width="1.4" stroke-linejoin="round"></path>
      </svg>
    </div>
  </div>

  <div class="vx-palette"><i style="--i:0"></i><i style="--i:1"></i><i style="--i:2"></i><i style="--i:3"></i></div>
  <div class="vx-type">Aa</div>
</div>

<style>
  .vx { position: relative; padding: 0 0 54px 0; }

  .vx-frame {
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.06);
    box-shadow: 0 30px 60px -40px #000;
    overflow: hidden;
  }
  .vx-top {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 15px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .vx-top i { width: 9px; height: 9px; border-radius: 99px; background: rgba(255, 255, 255, 0.22); }
  .vx-top span {
    margin-left: 10px;
    padding: 3px 14px;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .vx-canvas { position: relative; padding: 16px 18px 20px; background: #fbfbff; }

  .vx-nav { display: flex; align-items: center; gap: 10px; }
  .vx-nav b { width: 44px; height: 9px; border-radius: 4px; background: #02026c; margin-right: auto; }
  .vx-nav i { width: 28px; height: 6px; border-radius: 4px; background: #d9d9ea; }

  .vx-hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 16px; margin-top: 18px; align-items: center; }
  .vx-copy { position: relative; display: grid; gap: 9px; }
  .vx-h { height: 15px; border-radius: 5px; background: #02026c; transform-origin: 0 50%; animation: vx-grow 8s var(--ease) infinite; }
  .vx-h1 { width: 92%; }
  .vx-h2 { width: 64%; animation-delay: 0.15s; background: linear-gradient(90deg, #02026c, var(--c)); }
  .vx-p { width: 80%; height: 7px; border-radius: 4px; background: #d9d9ea; transform-origin: 0 50%; animation: vx-grow 8s var(--ease) infinite 0.3s; }
  .vx-btn {
    width: 74px; height: 24px;
    margin-top: 5px;
    border-radius: 99px;
    background: var(--c);
    animation: vx-press 8s var(--ease) infinite;
  }
  @keyframes vx-grow {
    0% { transform: scaleX(0); opacity: 0; }
    10%, 90% { transform: scaleX(1); opacity: 1; }
    100% { transform: scaleX(0); opacity: 0; }
  }
  @keyframes vx-press {
    0%, 8% { transform: scale(0); }
    16%, 62% { transform: scale(1); box-shadow: 0 0 0 0 transparent; }
    66% { transform: scale(0.9); }
    70% { transform: scale(1); box-shadow: 0 0 0 9px color-mix(in srgb, var(--c) 25%, transparent); }
    78%, 92% { transform: scale(1); box-shadow: 0 0 0 0 transparent; }
    100% { transform: scale(0); }
  }

  .vx-img {
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    background: linear-gradient(130deg, #02026c, #3d5afe 34%, #00cfe8 62%, #7b5cff 100%);
    background-size: 280% 280%;
    animation: vx-hue 8s ease-in-out infinite alternate, vx-pop 8s var(--ease) infinite;
  }
  @keyframes vx-hue { from { background-position: 0% 20%; } to { background-position: 100% 80%; } }
  @keyframes vx-pop {
    0% { transform: translateY(14px) scale(0.92); opacity: 0; }
    12%, 90% { transform: none; opacity: 1; }
    100% { transform: translateY(14px) scale(0.92); opacity: 0; }
  }

  .vx-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-top: 16px; }
  .vx-cards i {
    height: 46px;
    border-radius: 10px;
    border: 1px solid #e6e6ef;
    background: #fff;
    animation: vx-pop 8s var(--ease) infinite;
    animation-delay: calc(0.35s + var(--i) * 0.12s);
  }

  /* selección sobre el titular */
  .vx-select {
    position: absolute;
    inset: -6px auto auto -7px;
    width: 97%;
    height: 54px;
    border: 1.5px solid var(--c);
    border-radius: 3px;
    animation: vx-select 8s var(--ease) infinite;
  }
  .vx-select i { position: absolute; width: 7px; height: 7px; background: #fff; border: 1.5px solid var(--c); }
  .vx-select i:nth-child(1) { top: -4px; left: -4px; }
  .vx-select i:nth-child(2) { top: -4px; right: -4px; }
  .vx-select i:nth-child(3) { bottom: -4px; left: -4px; }
  .vx-select i:nth-child(4) { bottom: -4px; right: -4px; }
  @keyframes vx-select {
    0%, 26% { opacity: 0; transform: scale(0.96); }
    32%, 54% { opacity: 1; transform: none; }
    60%, 100% { opacity: 0; transform: scale(0.96); }
  }

  .vx-cursor {
    position: absolute;
    left: 0; top: 0;
    filter: drop-shadow(0 4px 6px rgba(1, 1, 63, 0.35));
    animation: vx-cursor 8s var(--ease) infinite;
  }
  @keyframes vx-cursor {
    0%, 14% { transform: translate(340px, 210px); opacity: 0; }
    20% { opacity: 1; }
    32%, 52% { transform: translate(150px, 62px); }
    64%, 72% { transform: translate(58px, 136px); }
    90% { transform: translate(300px, 190px); opacity: 1; }
    100% { transform: translate(340px, 210px); opacity: 0; }
  }

  .vx-palette {
    position: absolute;
    left: 18px;
    bottom: 0;
    display: flex;
    gap: 8px;
    padding: 10px 12px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(8, 8, 80, 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 24px 50px -30px #000;
  }
  .vx-palette i {
    width: 26px; height: 26px;
    border-radius: 8px;
    animation: vx-swatch 4s var(--ease) infinite;
    animation-delay: calc(var(--i) * 0.2s);
  }
  .vx-palette i:nth-child(1) { background: #02026c; outline: 1px solid rgba(255, 255, 255, 0.3); }
  .vx-palette i:nth-child(2) { background: #3d5afe; }
  .vx-palette i:nth-child(3) { background: #00cfe8; }
  .vx-palette i:nth-child(4) { background: #7b5cff; }
  @keyframes vx-swatch { 0%, 60%, 100% { transform: none; } 20% { transform: translateY(-7px) scale(1.12); } }

  .vx-type {
    position: absolute;
    right: 10px;
    bottom: -8px;
    font-family: var(--font-display);
    font-size: 3.4rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: #fff;
    animation: vx-weight 5s ease-in-out infinite alternate;
  }
  @keyframes vx-weight {
    from { font-variation-settings: "wght" 300; letter-spacing: 0.02em; }
    to { font-variation-settings: "wght" 700; letter-spacing: -0.06em; }
  }
</style>
